<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <gradient
        android:angle="0"
        android:startColor="#0A1424"
        android:centerColor="#081221"
        android:endColor="#04070D" />
      <corners android:radius="24dp" />
    </shape>
  </item>
  <item android:left="24dp" android:top="24dp" android:right="24dp" android:bottom="24dp">
    <shape android:shape="rectangle">
      <stroke
        android:width="1dp"
        android:color="#2E4C78" />
      <corners android:radius="18dp" />
    </shape>
  </item>
  <item android:left="32dp" android:top="24dp" android:bottom="24dp" android:right="170dp">
    <bitmap
      android:src="@drawable/drivedeck_tv_icon_art"
      android:gravity="center" />
  </item>
</layer-list>
