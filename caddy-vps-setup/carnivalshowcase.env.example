PORT=3000
HOST=127.0.0.1

GOOGLE_DRIVE_API_KEY=YOUR_GOOGLE_DRIVE_API_KEY

FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_WEB_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_WEB_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
FIREBASE_WEB_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_WEB_APP_ID=YOUR_APP_ID
FIREBASE_WEB_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

CUSTOM_DOMAIN_CNAME_TARGET=your-vps-domain.example.com
FIREBASE_CUSTOMDOMAINS_COLLECTION=customDomains

# Optional Firestore Admin setup if needed on the server.
# The on-demand TLS allow-check can also fall back to the public Firestore REST API
# when these are omitted, as long as the Firebase web config above is correct.
# FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
# or
# FIREBASE_SERVICE_ACCOUNT_BASE64=BASE64_ENCODED_JSON
# or
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/carnivalshowcase/firebase-service-account.json
